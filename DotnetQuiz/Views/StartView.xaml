<UserControl x:Class="DotnetQuiz.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
            <TextBlock Text="DotnetQuiz"
                       FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <TextBlock Text="Выберите сложность:" FontSize="16" Margin="0,0,0,12"/>

            <RadioButton Content="Лёгкая" GroupName="Difficulty"
                         IsChecked="{Binding SelectedDifficulty, Converter={StaticResource DifficultyToBoolConverter}, ConverterParameter=Easy}"/>
            <RadioButton Content="Средняя" GroupName="Difficulty"
                         IsChecked="{Binding SelectedDifficulty, Converter={StaticResource DifficultyToBoolConverter}, ConverterParameter=Medium}"/>
            <RadioButton Content="Сложная" GroupName="Difficulty"
                         IsChecked="{Binding SelectedDifficulty, Converter={StaticResource DifficultyToBoolConverter}, ConverterParameter=Hard}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                <Button Content="Начать" Command="{Binding StartCommand}" Width="130" Margin="0,0,12,0"/>
                <Button Content="Выход" Command="{Binding ExitCommand}" Width="130"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
