<Application
    x:Class="DotnetQuiz.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DotnetQuiz.Converters"
    xmlns:views="clr-namespace:DotnetQuiz.Views"
    xmlns:vm="clr-namespace:DotnetQuiz.ViewModels">
    <Application.Resources>
        <ResourceDictionary>

            <!--  Цветовая схема navy/white  -->
            <SolidColorBrush x:Key="NavyBrush" Color="#0B1F3A" />
            <SolidColorBrush x:Key="NavyLightBrush" Color="#1E3A5F" />
            <SolidColorBrush x:Key="TextColorBrush" Color="#FF2400" />
            <SolidColorBrush x:Key="DisabledBrush" Color="#CCCCCC" />

            <!--  Конвертеры  -->
            <conv:EnumToBooleanConverter x:Key="DifficultyToBoolConverter" />
            <conv:IndexToBooleanConverter x:Key="IndexToBoolConverter" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!--  Шаблоны отображения ViewModel -> View  -->
            <DataTemplate DataType="{x:Type vm:StartViewModel}">
                <views:StartView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuizViewModel}">
                <views:QuizView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResultViewModel}">
                <views:ResultView />
            </DataTemplate>

            <!--  Общий стиль окна  -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource TextColorBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Margin" Value="0,6" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
