<Application x:Class="DotnetQuiz.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetQuiz.ViewModels"
             xmlns:views="clr-namespace:DotnetQuiz.Views"
             xmlns:conv="clr-namespace:DotnetQuiz.Converters">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Цветовая схема navy/white -->
            <SolidColorBrush x:Key="NavyBrush" Color="#0B1F3A"/>
            <SolidColorBrush x:Key="NavyLightBrush" Color="#1E3A5F"/>
            <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="DisabledBrush" Color="#CCCCCC"/>

            <!-- Конвертеры -->
            <conv:EnumToBooleanConverter x:Key="DifficultyToBoolConverter"/>
            <conv:IndexToBooleanConverter x:Key="IndexToBoolConverter"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- Шаблоны отображения ViewModel -> View -->
            <DataTemplate DataType="{x:Type vm:StartViewModel}">
                <views:StartView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuizViewModel}">
                <views:QuizView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResultViewModel}">
                <views:ResultView/>
            </DataTemplate>

            <!-- Общий стиль окна -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Margin" Value="0,6"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource NavyLightBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource DisabledBrush}"/>
                        <Setter Property="Foreground" Value="#777777"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
